{
	"name": "trellune",
	"version": "1.7.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"build": "vite build",
		"build:demo": "cross-env VITE_DEMO_MODE=true vite build",
		"build:dev": "cross-env CLOUDFLARE_ENV=dev vite build",
		"build:production": "cross-env CLOUDFLARE_ENV=production vite build",
		"preview": "vite preview",
		"dev:demo": "cross-env VITE_DEMO_MODE=true vite",
		"deploy": "pnpm deploy:production",
		"deploy:dev": "pnpm build:dev && wrangler deploy --config wrangler.local.jsonc --env dev",
		"deploy:production": "pnpm build:production && wrangler deploy --config wrangler.local.jsonc --env production",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -b --pretty false",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:d1:local": "pnpm build && node scripts/verify-local-d1.mjs",
		"test:pwa:update": "node scripts/verify-pwa-update.mjs",
		"test:demo": "cross-env VITE_DEMO_MODE=true playwright test e2e/demo.spec.ts --project=mobile-chromium",
		"docs:check-links": "node scripts/check-markdown-links.mjs",
		"public:check": "node scripts/check-public-tree.mjs",
		"public:export": "node scripts/export-public-snapshot.mjs",
		"prompts:generate": "node scripts/generate-prompt-artifacts.mjs",
		"prompts:check": "node scripts/generate-prompt-artifacts.mjs --check",
		"playwright": "playwright",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply english-os-local --local",
		"db:seed:local": "wrangler d1 execute english-os-local --local --file=./db/seed.sql"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@cloudflare/vite-plugin": "^1.50.0",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"axe-core": "^4.12.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.8.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vitest": "~4.1.10",
		"wrangler": "^4.119.0"
	},
	"dependencies": {
		"dexie": "^4.4.4",
		"hono": "^4.13.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.2",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-window": "^7.4.1",
		"zod": "^4.4.3"
	}
}
